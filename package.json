{
  "name": "qq-agent",
  "version": "2.9.45",
  "private": true,
  "description": "Standalone QQ agent desktop app: event-driven stateless agent runs over an OpenAI-compatible API, with a session-style UI. Decoupled from DeepSeek Harness.",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "test": "node test/lint-account-check.mjs && node test/selftest.mjs",
    "test:prompt": "node test/test-prompt.mjs",
    "lint:account": "node test/lint-account-check.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "qrcode": "^1.5.4",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  }
}